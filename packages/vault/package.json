{
  "name": "@ponctua/vault",
  "version": "0.0.0",
  "private": true,
  "description": "OAuth token vault (ADR 006): seal anywhere with public keys, open only where the master private key lives (worker).",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./seal": {
      "types": "./dist/seal.d.ts",
      "default": "./dist/seal.js"
    },
    "./open": {
      "types": "./dist/open.d.ts",
      "default": "./dist/open.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "keygen": "node dist/keygen.js"
  },
  "dependencies": {
    "@ponctua/db": "workspace:*"
  },
  "devDependencies": {
    "@ponctua/config": "workspace:*",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "eslint": "10.14.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
