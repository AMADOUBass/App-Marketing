// Business tables. Conventions (CLAUDE.md section 6):
// - uuid primary keys generated by PostgreSQL 18 uuidv7(), timestamptz dates
// - every table carries organization_id, with UNIQUE (organization_id, id) and composite foreign keys
// - row-level security is added by the SQL migration "rls" (Prisma cannot express it)

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  importFileExtension    = "js"
  generatedFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
  // Identity tables (Better Auth) live in their own schema, reachable only by the app_auth role (ADR 008).
  schemas  = ["public", "auth"]
}

enum OrganizationRole {
  owner
  admin
  member

  @@map("organization_role")
  @@schema("public")
}

model Organization {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspaces         Workspace[]
  memberships        Membership[]
  posts              Post[]
  socialAccounts     SocialAccount[]
  publicationTargets PublicationTarget[]
  publishAttempts    PublishAttempt[]
  key                OrganizationKey?
  oauthCredentials   OauthCredential[]

  @@map("organizations")
  @@schema("public")
}

model Workspace {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  /// IANA time zone used to display and schedule posts (e.g. America/Toronto).
  timezone       String   @default("America/Toronto")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  posts          Post[]
  socialAccounts SocialAccount[]

  @@unique([organizationId, id])
  @@map("workspaces")
  @@schema("public")
}

/// Organization membership: the link between an identity (auth.users) and a tenant.
model Membership {
  id             String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           OrganizationRole
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, id])
  @@unique([organizationId, userId])
  @@index([userId])
  @@map("memberships")
  @@schema("public")
}

model Post {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  workspaceId    String   @map("workspace_id") @db.Uuid
  body           String
  /// Phase 0 only (ADR 007): public HTTPS URL of a JPEG to publish. Replaced by the media library.
  imageUrl       String?  @map("image_url")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Composite key: a post can only belong to a workspace of the same organization.
  workspace    Workspace           @relation(fields: [organizationId, workspaceId], references: [organizationId, id], onDelete: Cascade)
  targets      PublicationTarget[]

  @@unique([organizationId, id])
  @@index([organizationId, workspaceId])
  @@map("posts")
  @@schema("public")
}

enum Platform {
  facebook
  instagram
  threads
  youtube
  linkedin
  tiktok

  @@map("platform")
  @@schema("public")
}

/// A connected social account (page, profile, channel). OAuth tokens live elsewhere, encrypted (0.9).
model SocialAccount {
  id                String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  workspaceId       String   @map("workspace_id") @db.Uuid
  platform          Platform
  /// Account id on the platform (e.g. Instagram professional account id).
  externalAccountId String   @map("external_account_id")
  displayName       String   @map("display_name")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace           @relation(fields: [organizationId, workspaceId], references: [organizationId, id], onDelete: Cascade)
  targets      PublicationTarget[]
  credential   OauthCredential?

  @@unique([organizationId, id])
  @@unique([organizationId, platform, externalAccountId])
  @@map("social_accounts")
  @@schema("public")
}

/// Per-organization X25519 key pair (ADR 006). The public key seals OAuth tokens (API side); the
/// private key is stored sealed with the master public key and can only be unsealed where the master
/// private key lives (worker). Deleting this row makes every token of the organization unrecoverable.
model OrganizationKey {
  id               String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId   String   @unique @map("organization_id") @db.Uuid
  /// Raw 32-byte X25519 public key.
  publicKey        Bytes    @map("public_key")
  /// Org private key sealed with the master public key identified by master_key_id.
  sealedPrivateKey Bytes    @map("sealed_private_key")
  masterKeyId      String   @map("master_key_id")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  credentials  OauthCredential[]

  @@unique([organizationId, id])
  @@map("organization_keys")
  @@schema("public")
}

/// OAuth tokens of a social account, sealed with the organization public key (never stored in clear).
model OauthCredential {
  id                String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  socialAccountId   String    @unique @map("social_account_id") @db.Uuid
  organizationKeyId String    @map("organization_key_id") @db.Uuid
  /// Sealed box (format v1, see @ponctua/vault) of the token JSON.
  sealedTokens      Bytes     @map("sealed_tokens")
  scopes            String[]
  /// Access token expiry reported by the platform (never a hardcoded duration).
  expiresAt         DateTime? @map("expires_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  socialAccount   SocialAccount   @relation(fields: [organizationId, socialAccountId], references: [organizationId, id], onDelete: Cascade)
  organizationKey OrganizationKey @relation(fields: [organizationId, organizationKeyId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, id])
  @@unique([organizationId, socialAccountId])
  @@map("oauth_credentials")
  @@schema("public")
}

/// Lifecycle of one post on one social account (CLAUDE.md section 5).
enum PublicationState {
  draft
  pending_approval
  scheduled
  queued
  publishing
  uploading
  remote_processing
  published
  retrying
  failed
  needs_action
  unknown_outcome
  reconciled
  cancelled

  @@map("publication_state")
  @@schema("public")
}

/// Unit of execution: one post x one social account.
model PublicationTarget {
  id                  String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId      String           @map("organization_id") @db.Uuid
  postId              String           @map("post_id") @db.Uuid
  socialAccountId     String           @map("social_account_id") @db.Uuid
  state               PublicationState @default(draft)
  scheduledAt         DateTime?        @map("scheduled_at") @db.Timestamptz(6)
  /// Set when the scheduler hands the target to the queue.
  queuedAt            DateTime?        @map("queued_at") @db.Timestamptz(6)
  /// Incremented on each hand-off to the queue; part of the job id.
  attemptCount        Int              @default(0) @map("attempt_count")
  /// Set when a worker starts publishing. A target stuck past the lease is moved to unknown_outcome.
  publishingStartedAt DateTime?        @map("publishing_started_at") @db.Timestamptz(6)
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  post          Post             @relation(fields: [organizationId, postId], references: [organizationId, id], onDelete: Cascade)
  socialAccount SocialAccount    @relation(fields: [organizationId, socialAccountId], references: [organizationId, id], onDelete: Cascade)
  attempts      PublishAttempt[]

  @@unique([organizationId, id])
  /// A post can target a social account only once (no double publication).
  @@unique([postId, socialAccountId])
  @@map("publication_targets")
  @@schema("public")
}

/// Error classes (CLAUDE.md section 5). Only transient and quota are retried.
enum ErrorClass {
  transient
  quota
  auth
  content
  unknown

  @@map("error_class")
  @@schema("public")
}

/// One row per execution attempt of a target. Written in the same transaction as queued -> publishing:
/// the unique (target_id, attempt_no) makes a second execution of the same attempt impossible.
/// finished_at NULL after the lease means the worker died mid-publish.
model PublishAttempt {
  id             String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  targetId       String            @map("target_id") @db.Uuid
  attemptNo      Int               @map("attempt_no")
  startedAt      DateTime          @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt     DateTime?         @map("finished_at") @db.Timestamptz(6)
  outcome        PublicationState?
  errorClass     ErrorClass?       @map("error_class")
  /// Sanitized platform request/response (filled by adapters; never tokens).
  request        Json?
  response       Json?

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  target       PublicationTarget @relation(fields: [organizationId, targetId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, id])
  @@unique([targetId, attemptNo])
  @@map("publish_attempts")
  @@schema("public")
}

// ---------------------------------------------------------------------------------------------------------
// Identity (Better Auth 1.7, core schema). Schema "auth": no organization_id (a user belongs to several
// organizations), reachable ONLY by the app_auth role used by Better Auth in the API (ADR 008).
// Prisma field names must match Better Auth's field names (camelCase); columns stay snake_case.
// ---------------------------------------------------------------------------------------------------------

model User {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions    Session[]
  accounts    Account[]
  memberships Membership[]

  @@map("users")
  @@schema("auth")
}

model Session {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  /// Opaque session token (Better Auth stores it; the cookie carries a signed copy).
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
  @@schema("auth")
}

/// One way to sign in (password, later social providers). `password` holds a hash, never a clear value.
model Account {
  id                    String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
  @@schema("auth")
}

/// Short-lived verification values (email verification, password reset).
model Verification {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([identifier])
  @@map("verifications")
  @@schema("auth")
}
