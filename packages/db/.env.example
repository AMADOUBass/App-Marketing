# Copy to packages/db/.env. Ports match infra/compose (use 5433 if a local PostgreSQL already uses 5432).

# Prisma CLI (migrations): schema owner role.
MIGRATION_DATABASE_URL=postgresql://app_migrator:migrator_dev@127.0.0.1:5432/app

# Runtime role, used by `pnpm db:seed` (demo data).
DATABASE_URL=postgresql://app_user:app_user_dev@127.0.0.1:5432/app
