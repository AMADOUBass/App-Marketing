{
  "name": "@app/config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared TypeScript, ESLint and Prettier configuration for the monorepo.",
  "type": "module",
  "exports": {
    "./tsconfig/base.json": "./tsconfig/base.json",
    "./tsconfig/node.json": "./tsconfig/node.json",
    "./tsconfig/nest.json": "./tsconfig/nest.json",
    "./tsconfig/react.json": "./tsconfig/react.json",
    "./eslint": "./eslint/index.js",
    "./prettier": "./prettier/index.js"
  },
  "files": [
    "tsconfig",
    "eslint",
    "prettier"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@eslint/js": "10.0.1",
    "globals": "17.14.0",
    "typescript-eslint": "8.72.1"
  },
  "peerDependencies": {
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
