{
  "name": "@app/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --exec \"node --env-file-if-exists=.env --enable-source-maps\"",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@app/db": "workspace:*",
    "@app/integrations": "workspace:*",
    "@app/vault": "workspace:*",
    "@nestjs/common": "12.4.0",
    "@nestjs/core": "12.4.0",
    "bullmq": "6.7.4",
    "ioredis": "6.0.0",
    "pino": "10.4.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@app/config": "workspace:*",
    "@nestjs/cli": "12.0.12",
    "@swc/cli": "0.8.2",
    "@swc/core": "1.16.22",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "pino-pretty": "13.2.0",
    "testcontainers": "12.2.1",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.1.0"
  }
}
