# Copy to apps/worker/.env for local development (loaded by `pnpm dev`).
NODE_ENV=development
LOG_LEVEL=debug
LOG_PRETTY=true

# scheduler | publish | all (all = both loops in one process, for local development)
PROCESS_ROLE=all

# Runtime database role (app_user). Use port 5433 if a local PostgreSQL already uses 5432.
DATABASE_URL=postgresql://app_user:app_user_dev@127.0.0.1:5432/app
VALKEY_URL=redis://:valkey_dev@127.0.0.1:6379

SCHEDULER_TICK_MS=10000
SCHEDULER_HORIZON_SECONDS=60

# --- Instagram publishing (feature flag, ADR 007). Off: targets end in needs_action, nothing is sent. ---
# INSTAGRAM_PUBLISHING_ENABLED=true
# Vault master PRIVATE key(s) from `pnpm vault:keygen`, "id:key" (worker ONLY, never the API).
# VAULT_MASTER_PRIVATE_KEYS=
