{
  "name": "@ponctua/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --exec \"node --env-file-if-exists=.env --enable-source-maps --import ./dist/instrumentation.js\"",
    "start": "node --enable-source-maps --import ./dist/instrumentation.js dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.7.15",
    "@nestjs/common": "12.4.0",
    "@nestjs/core": "12.4.0",
    "@nestjs/platform-fastify": "12.4.0",
    "@opentelemetry/instrumentation": "0.301.0",
    "@opentelemetry/instrumentation-http": "0.301.0",
    "@opentelemetry/instrumentation-pino": "0.71.0",
    "@opentelemetry/sdk-node": "0.301.0",
    "@ponctua/contracts": "workspace:*",
    "@ponctua/db": "workspace:*",
    "@ponctua/integrations": "workspace:*",
    "@ponctua/vault": "workspace:*",
    "better-auth": "1.7.15",
    "fastify": "5.12.8",
    "nestjs-pino": "5.3.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.12",
    "@nestjs/testing": "12.4.0",
    "@ponctua/config": "workspace:*",
    "@swc/cli": "0.8.2",
    "@swc/core": "1.16.22",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "pino-pretty": "13.2.0",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.1.0"
  }
}
