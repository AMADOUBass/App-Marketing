# Copy to apps/api/.env for local development (loaded by `pnpm dev`).
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=debug
LOG_PRETTY=true

# Runtime database role (app_user, subject to row-level security). Use port 5433 if a local
# PostgreSQL already uses 5432 (see infra/compose/.env).
DATABASE_URL=postgresql://app_user:app_user_dev@127.0.0.1:5432/app

# Temporary, local only (ADR 003): pick the organization with the x-dev-organization-id header.
# Refused when NODE_ENV=production.
DEV_TENANT_HEADER=true

# --- Authentication (Better Auth, ADR 008) ---
# Random 32+ characters signing session cookies (e.g. node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))").
BETTER_AUTH_SECRET=
# Public origin of the web app: the browser reaches /api/auth through it (Vite proxy in development).
BETTER_AUTH_URL=http://localhost:5173
# Extra allowed origins, comma-separated (e.g. the tunnel URL). Defaults to BETTER_AUTH_URL.
# Vite listens on 127.0.0.1: allow both spellings of the dev origin (add the tunnel URL when used).
TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# app_auth role: reads and writes the "auth" schema only (users, sessions), nothing else.
AUTH_DATABASE_URL=postgresql://app_auth:app_auth_dev@127.0.0.1:5432/app

# OpenTelemetry is off unless an OTLP endpoint is set.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_SERVICE_NAME=app-api

# --- Instagram connection (ADR 007). All or nothing: leave every line commented to keep it off. ---
# Meta app id (public) and app secret (NEVER commit it, never paste it anywhere else).
# META_APP_ID=1604528421424442
# META_APP_SECRET=
# Configuration id from "API setup with Unified login" (public).
# INSTAGRAM_CONFIG_ID=
# Public HTTPS URLs from `pnpm tunnel` (they change at each tunnel start: update Meta too).
# INSTAGRAM_REDIRECT_URI=https://<tunnel>.trycloudflare.com/api/v1/integrations/instagram/callback
# WEB_APP_URL=https://<tunnel>.trycloudflare.com
# Random 32+ characters signing the OAuth state (e.g. node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))").
# OAUTH_STATE_SECRET=
# Vault master PUBLIC key from `pnpm vault:keygen` (the private key goes to the worker only).
# VAULT_MASTER_KEY_ID=
# VAULT_MASTER_PUBLIC_KEY=
