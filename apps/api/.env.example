# Copy to apps/api/.env for local development (loaded by `pnpm dev`).
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=debug
LOG_PRETTY=true

# Runtime database role (app_user, subject to row-level security). Use port 5433 if a local
# PostgreSQL already uses 5432 (see infra/compose/.env).
DATABASE_URL=postgresql://app_user:app_user_dev@127.0.0.1:5432/app

# Temporary, local only (ADR 003): pick the organization with the x-dev-organization-id header.
# Refused when NODE_ENV=production.
DEV_TENANT_HEADER=true

# OpenTelemetry is off unless an OTLP endpoint is set.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_SERVICE_NAME=app-api
