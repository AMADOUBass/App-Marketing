# Local development only. Copy to infra/compose/.env to override the defaults.
# Never reuse these values outside your machine.

# PostgreSQL 18
POSTGRES_PORT=5432
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres_dev
APP_DB_NAME=app
APP_MIGRATOR_PASSWORD=migrator_dev
APP_USER_PASSWORD=app_user_dev

# Valkey 8.1
VALKEY_PORT=6379
VALKEY_PASSWORD=valkey_dev

# S3-compatible storage (RustFS, stands in for Cloudflare R2)
S3_PORT=9000
S3_CONSOLE_PORT=9001
S3_ACCESS_KEY_ID=app_dev_access
S3_SECRET_ACCESS_KEY=app_dev_secret_change_me
S3_BUCKET_MEDIA=media

# Connection strings used by the apps (later phases)
# DATABASE_URL=postgresql://app_user:app_user_dev@127.0.0.1:5432/app
# MIGRATION_DATABASE_URL=postgresql://app_migrator:migrator_dev@127.0.0.1:5432/app
# VALKEY_URL=redis://:valkey_dev@127.0.0.1:6379
# S3_ENDPOINT=http://127.0.0.1:9000
